# Não use chaves de teste em produção.
PORT=4173
# Opcional: origem canônica fixa. Deixe vazio no preview da Vercel.
# Na Vercel, o adaptador usa a origem da requisição quando não há SITE_URL.
SITE_URL=
# O fluxo atual pelo WhatsApp não precisa das chaves abaixo.
# Configure o conjunto completo somente se ativar envio por e-mail no futuro.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
BOOKING_FROM=
BOOKING_TO=
# Redis REST (Upstash ou serviço compatível) para rate limit distribuído.
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
# Telefone oficial confirmado em content.json: (54) 99932-1003.

NODE_ENV=development
